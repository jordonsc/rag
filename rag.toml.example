# RAG configuration — copy to `rag.toml` and adjust. NEVER put API keys here.
# Secrets are read from the environment only:
#   VOYAGE_API_KEY     (required when a Voyage client is constructed)
#   QDRANT_API_KEY     (optional; only if your Qdrant requires auth)
#   ANTHROPIC_API_KEY  (optional; enables POST /ledger/{id}/summarise and the web
#                       UI's Summarise tab. Absent = that one route 503s, nothing else
#                       changes. There is no model/prompt setting here on purpose:
#                       the allow-listed models and the default system prompt are
#                       constants in `core::anthropic`, served to the UI by /info.)
#
# Any field below can be overridden by an env var prefixed with `RAG_`, using
# `__` for nesting, e.g.  RAG_QDRANT__URL=http://localhost:6334

[corpus]
# Root of all local code repositories (used by `--source local`). Each top-level
# dir is treated as a `repo`.
code_root = "/path/to/repos"
# Root of the markdown document library (the wiki corpus).
wiki_root = "/path/to/repos/wiki"

[qdrant]
# gRPC endpoint of the Qdrant instance (port 6334 is gRPC; 6333 is REST).
url = "http://localhost:6334"
collection = "rag_corpus"

[voyage]
embed_model = "voyage-4-large"
rerank_model = "rerank-2.5"
# Embedding dimensionality. voyage-4-large supports 256/512/1024/2048.
dimensions = 1024

[chunk]
# Target chunk size in tokens (aligned to the embedding tokenizer) + overlap.
max_tokens = 512
overlap_tokens = 64

[ingest]
# Skip source files larger than this many bytes during discovery.
max_file_bytes = 1000000
# Density guard: skip a file whose ESTIMATED characters per token fall below
# this (generated SVG path data ~1.3-1.6; source and prose >= 1.8). Files under
# density_min_bytes are exempt. 0 disables the guard. Per-repo exclusions go in
# a `.ragignore` (gitignore syntax) in that repo instead.
min_chars_per_token = 1.7
density_min_bytes = 4096
# Circuit breaker: after this many consecutive runs fail on the same pending
# work with the same error, stop attempting it until the inputs change
# (`rag-ingest run --force` overrides). 0 disables it.
breaker_threshold = 3
# Breaker state file. Empty = <github.work_dir>/.rag-ingest-breaker.json.
breaker_path = ""

[github]
# Corpus source when running with `--source github`. The PAT is read from the
# environment (GITHUB_TOKEN), never from this file. Archived repos are always
# skipped (and purged from the index).
account = "your-github-account"           # GitHub user/org whose repos form the corpus
work_dir = "/path/to/rag/corpus"          # where shallow clones are kept
wiki_repo = "wiki"                        # repo treated as the `wiki` corpus
include_forks = true                      # set false to skip forked repos
exclude = []                              # repo names to skip entirely

[server]
# Bind address for the HTTP retrieval service.
bind = "0.0.0.0:17793"
# ANN candidate set fetched before reranking (the over-fetch), and the default
# number of results returned when a /search request omits `top_k`.
over_fetch = 50
default_top_k = 8
# Path to a file `POST /reindex` writes to trigger an immediate re-index. Empty
# disables the endpoint. In the container deployment the unit sets this to
# /triggers/reindex (a systemd .path unit watches it and starts rag-sync.service).
reindex_trigger = ""
# Files rag-serve touches after a ledger write and after a successful tracker write,
# to start an immediate reconcile of `corpus = ledger` / `corpus = tracker`. Empty
# disables them (the 15-min timers then keep the index current). The container
# deployment sets /triggers/ledger-reindex and /triggers/tracker-reindex, watched by
# rag-ledger-reindex.path and rag-tracker-reindex.path.
ledger_reindex_trigger = ""
tracker_reindex_trigger = ""
# Directory holding the built ledger web UI (the `dist/` with index.html at its
# root), served at / on the same port as the API. Empty disables it, and so does
# a directory with no index.html — either way the JSON API is unaffected.
web_root = ""
# Directory of saved Summarise system prompts — one plain Markdown file per prompt
# (`Terse.md` is the prompt named "Terse"), which the web UI's chooser reads and
# writes and which an operator can equally manage with a text editor. Empty (the
# default) means no library: only the built-in default prompt is offered and
# POST /prompts/save and /prompts/delete answer 503. A configured directory that
# does not exist yet is an empty library, created on the first save.
#
# The built-in default prompt is a constant in `core::anthropic` and is NEVER
# written here: an empty directory is a fallback to it, not a missing file.
#
# In the container deployment the unit sets this to /prompts, bind-mounted from
# ~/rag/prompts on the host — deliberately not ~/.config/rag/prompts, which is
# where the secrets env file lives.
prompts_dir = ""

[tracker]
# The tracker's SQLite store (specs/tracker): each project's queue, specs and concepts.
# Its own file beside the ledger's, so a fault in or a restore of one never touches the
# other. Created if missing (WAL mode). Defaults to $HOME/rag/tracker/tracker.db; the
# container sets /tracker/tracker.db, bind-mounted from ~/rag/tracker on the host.
# A store that cannot open is not fatal: the /tracker routes answer 503.
db_path = "/path/to/rag/tracker/tracker.db"
# Attachments (images and other files in tracker documents), stored by content hash as
# <sha256[0..2]>/<sha256>. Created if missing. Defaults to $HOME/rag/tracker/attachments.
attachments_dir = "/path/to/rag/tracker/attachments"
