# Deployment target for the RAG services. Copy to deploy/deploy.env (gitignored)
# and set your real value. Sourced by the Makefile and deploy/deploy.sh.
#
# SSH host (an alias from ~/.ssh/config, or user@host) of the server that runs the
# RAG stack: Qdrant + rag-serve + the sync/ledger timers.
DEPLOY_HOST=your-server
