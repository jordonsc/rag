# Daily RAG backup (Qdrant snapshot + ledger DB). Deploy to
#   ~/.config/systemd/user/rag-backup.timer
# then: systemctl --user enable --now rag-backup.timer

[Unit]
Description=Daily RAG backup

[Timer]
# Once a day. Persistent catches a missed run after host downtime; the jitter
# avoids colliding with the 15-min corpus sync.
OnCalendar=daily
Persistent=true
RandomizedDelaySec=15min

[Install]
WantedBy=timers.target
