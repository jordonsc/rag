{
  "compilerOptions": {
    "target": "ES2020",
    // The library is ES2022 while the emit target is not, and the two are
    // different questions: `target` gates the *syntax* this tree may write,
    // `lib` declares the *built-ins the runtime provides*. Every browser this
    // ships to, and Node under Vitest, has had the ES2021/ES2022 built-ins for
    // years. What it admits is library methods only — `Array.prototype.at`,
    // `Object.hasOwn`, `String.replaceAll`, `Error.cause`. No new syntax.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "noEmit": true
  }
}
